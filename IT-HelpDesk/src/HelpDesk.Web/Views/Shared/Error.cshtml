@{
    ViewData["Title"] = "Xəta";
    var requestId = System.Diagnostics.Activity.Current?.Id ?? Context.TraceIdentifier;
}
<div class="text-center py-5">
    <h1 class="display-6 text-danger">Gözlənilməz xəta baş verdi</h1>
    <p class="text-muted">Zəhmət olmasa bir az sonra yenidən cəhd edin.</p>
    <p class="small text-muted">Request ID: <code>@requestId</code></p>
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Ana səhifəyə qayıt</a>
</div>
