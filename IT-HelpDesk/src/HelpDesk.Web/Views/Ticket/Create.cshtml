@model TicketCreateViewModel
@{
    ViewData["Title"] = "Yeni müraciət";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <h1 class="h3 mb-3">Yeni texniki müraciət</h1>
        <form asp-action="Create" method="post" class="card card-body" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" maxlength="150" autofocus />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="CategoryId" class="form-label"></label>
                    <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select">
                        <option value="">-- Kateqoriya seçin --</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Priority" class="form-label"></label>
                    <select asp-for="Priority" asp-items="Model.Priorities" class="form-select"></select>
                    <span asp-validation-for="Priority" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="6" maxlength="2000" data-counter="#descCounter"></textarea>
                <div class="d-flex justify-content-between">
                    <span asp-validation-for="Description" class="text-danger"></span>
                    <small class="text-muted ms-auto"><span id="descCounter">0</span> / 2000</small>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Müraciəti göndər</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Ləğv et</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
